<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Mind Peace</string>
    <string name="accessibility_service_description">Mind Peace 用无障碍服务感知当前打开的应用，在你打开之前先盖住一层确认。不会读取聊天内容、密码或屏幕上的文字细节，只关心是哪一个应用来到了前台。完全在你的手机上运行，不收集、不上传任何使用记录。</string>

    <string name="channel_session_name">使用倒计时</string>
    <string name="channel_session_desc">正在进行的限时使用，显示剩余时间。</string>
    <string name="channel_reminder_name">时间到了</string>
    <string name="channel_reminder_desc">本次使用结束时的提醒。</string>
    <string name="channel_celebration_name">坚持提醒</string>
    <string name="channel_celebration_desc">一段时间没打开被守护应用时的鼓励。</string>
    <string name="channel_summary_name">每日小结</string>
    <string name="channel_summary_desc">每天晚上回顾今天和昨天的使用时长。</string>

    <string name="onboarding_welcome_title">先停一停，再打开</string>
    <string name="onboarding_welcome_body">Mind Peace 不会锁住整部手机。当你打开容易沉迷的视频流应用时，它会立刻盖住一层确认，问你是不是真的要打开。</string>
    <string name="onboarding_welcome_p1">打开前拦截，避免一滑就停不下来</string>
    <string name="onboarding_welcome_p2">自己选择这一次用多久</string>
    <string name="onboarding_welcome_p3">可以先设每天总时长，再分给各个应用</string>

    <string name="onboarding_self_title">写给自己的话</string>
    <string name="onboarding_self_body">每次被拦截时，你会先看见这句话。写一句目标，或一句轻轻的提醒，给当下的自己。</string>
    <string name="onboarding_self_hint">打开之前先问自己：现在真的需要吗？</string>
    <string name="onboarding_self_preset_1">打开之前先问自己：现在真的需要吗？</string>
    <string name="onboarding_self_preset_2">先停十秒，再决定要不要打开。</string>
    <string name="onboarding_self_preset_3">这不是休息，别把滑动当成放松。</string>
    <string name="onboarding_self_need">写几个字，或点选一句现成的。</string>

    <string name="onboarding_how_title">一次使用是怎样的</string>
    <string name="onboarding_how_1">打开被守护的应用时，立刻出现确认层，暂时用不了。</string>
    <string name="onboarding_how_2">选「确定」继续，或「退出」回到桌面。</string>
    <string name="onboarding_how_3">挑选时长（1 / 3 / 5 / 10 / 15 / 30 分钟，或自定义）。</string>
    <string name="onboarding_how_4">倒计时只在这个应用在前台时走。中途离开（回桌面、切到别的应用）会结束本次，没用完的时间作废；下次打开会再次询问。时间到会回到桌面并提醒你。</string>

    <string name="onboarding_a11y_title">开启无障碍服务</string>
    <string name="onboarding_a11y_body">系统不会告诉我们“你打开了哪个应用”，除非你把无障碍服务交给 Mind Peace。它只用来感知前台应用并及时盖住确认层，不会拿来读你的消息。</string>
    <string name="onboarding_a11y_action">去开启无障碍</string>
    <string name="onboarding_a11y_on">无障碍已开启</string>
    <string name="onboarding_a11y_off">尚未开启</string>

    <string name="onboarding_battery_title">减少被系统杀掉</string>
    <string name="onboarding_battery_body">倒计时需要在后台安静地走。请允许 Mind Peace 忽略电池优化，并在系统询问时允许通知（用于显示剩余时间）。</string>
    <string name="onboarding_battery_action">关闭电池优化</string>
    <string name="onboarding_battery_on">已忽略电池优化</string>
    <string name="onboarding_battery_off">仍受电池优化限制</string>
    <string name="onboarding_notif_title">打开通知</string>
    <string name="onboarding_notif_body">晚间小结和「忍住了」的鼓励都走通知。这次使用的倒计时也会显示在通知里。如果现在不允许，仍可以完成引导，之后会在首页再提醒你。</string>
    <string name="onboarding_notif_action">允许通知</string>
    <string name="onboarding_notif_on">通知已允许</string>
    <string name="onboarding_notif_off">通知未允许</string>

    <string name="onboarding_lock_title">锁定后台任务</string>
    <string name="onboarding_lock_body">部分手机厂商会在后台清掉应用，导致拦截失效。请按你的手机操作一次，然后勾选确认。</string>
    <string name="onboarding_lock_xiaomi">小米 / 红米：最近任务中下拉 Mind Peace 卡片，点锁定。</string>
    <string name="onboarding_lock_huawei">华为 / 荣耀：最近任务中下拉卡片锁定；电池设置里允许后台运行。</string>
    <string name="onboarding_lock_oppo">OPPO / 一加：最近任务右上角锁定；自启动管理中允许 Mind Peace。</string>
    <string name="onboarding_lock_vivo">vivo / iQOO：最近任务锁定；后台高耗电允许。</string>
    <string name="onboarding_lock_pixel">Pixel / 原生安卓：一般只需关闭电池优化，无需额外锁定。</string>
    <string name="onboarding_lock_check">我已按说明锁定后台（或确认不需要）</string>
    <string name="onboarding_privacy_title">完全在你的手机上</string>
    <string name="onboarding_privacy_body">Mind Peace 完全在你的手机上运行，不会上传任何使用记录。我们不收集数据。</string>

